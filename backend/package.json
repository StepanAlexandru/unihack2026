{
  "name": "@unihack2026/backend",
  "version": "1.0.0",
  "private": true,
  "description": "M4 orchestration API: /analyze, /narrate, /audio/*, /health, demo fixtures + offline fallback",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "mock": "node index.js --mock",
