  },
  "benchmark": {
    "style_metric": "top-1 accuracy against acceptable_styles, over all cases (negatives included)",
    "detail_metric": "per-type recall at IoU >= 0.3 against expected_details (real photos only; synthetic cards are a smoke test)",
    "how_to_run": "M2: for each case, run `npm run try -- ../demo/test-set/<photo or image>` and compare against this file."
