    "check:demo": "node scripts/build-demo-assets.js --check",
    "record:demo-audio": "node scripts/record-demo-audio.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
