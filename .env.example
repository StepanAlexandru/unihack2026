# =====================================================================
# Environment template. Copy to `.env` in the REPO ROOT:  cp .env.example .env
# NEVER commit `.env`. Owner: Module 4. Need a new variable? Ask M4 to add it here.
# Relative paths below resolve against the REPO ROOT, not the process cwd.
# Run module scripts with:  node --env-file=../.env <script>
# =====================================================================

# ---------- AI provider (M2 vision + M3 content) ----------
ANTHROPIC_API_KEY=
# Module owners may change these after measuring latency on real photos.
VISION_MODEL=claude-opus-5-5
CONTENT_MODEL=claude-opus-5-5

# ---------- M4 Backend ----------
PORT=3001
# "*" (default) or a comma-separated list. Not needed when the frontend proxies to the backend (same origin).
CORS_ORIGINS=*
# mock = backend's built-in stubs (never imports /vision or /content)
# live = imports vision/index.js / content/index.js (falls back to the stub, with a warning, if the export is missing)
VISION_MODE=mock
CONTENT_MODE=mock
# true = force built-in stubs regardless of the two modes above (same as `npm run mock`)
USE_STUBS=false
# Below this style confidence, /analyze returns 422 LOW_CONFIDENCE
VISION_MIN_CONFIDENCE=0.55
VISION_TIMEOUT_MS=15000
CONTENT_TIMEOUT_MS=15000
# Max decoded image size; larger returns 413 INVALID_INPUT
MAX_IMAGE_BYTES=6000000
DEMO_FIXTURES_DIR=./demo/fixtures
# Per-IP limit on POST /analyze + /narrate (0 = off). Over the limit: 429 + code TIMEOUT.
RATE_LIMIT_PER_MIN=60
# JSON request log lines on stdout
LOG_REQUESTS=true

# ---------- M4 Demo safety net ----------
# true = never call AI: known demo images answer from demo/offline-cache.json, others get NO_MATCH
OFFLINE_DEMO_MODE=false
# Optional fixture id returned for UNKNOWN images while OFFLINE_DEMO_MODE=true (e.g. casa-bruck). Empty = NO_MATCH.
OFFLINE_DEMO_DEFAULT_FIXTURE=
# In live mode, a KNOWN demo image answers from the offline cache once live has taken this long (or failed)
OFFLINE_FALLBACK_AFTER_MS=7000
# Perceptual-hash tolerance for matching a known demo image (bits out of 64). Keep low: wrong building > no match.
OFFLINE_HASH_MAX_DISTANCE=4
OFFLINE_CACHE_PATH=./demo/offline-cache.json
# Set to enable POST /demo/offline {"enabled":true} (header x-demo-admin-token). Empty = endpoint disabled.
DEMO_ADMIN_TOKEN=

# ---------- M3 Content + Audio ----------
# Runtime mp3 cache, served by M4 at /audio/cache/ (gitignored)
AUDIO_CACHE_DIR=./.cache/audio
# M3 picks the TTS provider. Use voices with good Romanian support.
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_RO=
TTS_VOICE_EN=

# ---------- M1 Frontend ----------
# Vite exposes ONLY VITE_* vars to the browser. NEVER put secrets here.
# Requires `envDir: '..'` in frontend/vite.config. Rename the prefix if M1 doesn't use Vite.
# Leave empty to call the same origin through the dev-server proxy (recommended).
VITE_API_BASE_URL=
# true = serve contract examples locally, no backend needed
VITE_USE_MOCK_API=true
